{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studybuddy-mobile",
  "compatibility_date": "2025-09-15",
  "pages_build_output_dir": "dist",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
